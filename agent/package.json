{
  "name": "avicv-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/chat/index.html --outdir dist/chat --public-path /chat/ --minify --splitting && bun scripts/compress-chat.ts",
    "darwin-probe": "bun scripts/darwin-probe.ts",
    "test:browser": "COPILOTKIT_TELEMETRY_DISABLED=true bun scripts/browser-check.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.49",
    "@ai-sdk/mcp": "^1.0.92",
    "@copilotkit/react-core": "^1.78.0",
    "@copilotkit/runtime": "^1.78.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "3.25.76",
    "rxjs": "7.8.1",
    "@ag-ui/client": "^1.0.2",
    "@ag-ui/core": "^1.0.2",
    "@openrouter/ai-sdk-provider": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
