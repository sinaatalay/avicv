{
	"name": "speedhack",
	"private": true,
	"type": "module",
	"workspaces": ["frontend", "agent"],
	"scripts": {
		"dev": "scripts/dev.sh",
		"dev:frontend": "bun --cwd=frontend run dev",
		"dev:backend": "uv run --directory backend fastapi dev",
		"dev:agent": "bun --cwd=agent run dev",
		"dev:jobs": "uv run --directory backend jobs-ingest --loop",
		"jobs:sync": "uv run --directory backend jobs-ingest --force",
		"build": "bun run --sequential build:frontend build:agent",
		"build:frontend": "bun --cwd=frontend run build",
		"build:agent": "bun --cwd=agent run build",
		"start": "bun scripts/start.ts",
		"check": "bun run --sequential check:frontend check:agent check:backend",
		"check:agent": "bun --cwd=agent run typecheck && bun --cwd=agent test",
		"check:frontend": "bun --cwd=frontend run check",
		"check:backend": "cd backend && uv run ruff check && uv run ruff format --check && uv run ty check && uv run pytest"
	}
}
