# Copy to backend/.env (gitignored) and fill in the keys.

# Résumé parsing with Gemini through OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Job matching with Jev through TypeSafe: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional settings, shown with their defaults:
# APP_ORIGIN=http://localhost:5173      # production: the public https://avicv.com origin
# UPLOADS_PER_DAY=10                    # per workspace, shared by UI and MCP
# TAILORS_PER_DAY=50
# CHATS_PER_DAY=50
# RETRIES_PER_DAY=10
# GLOBAL_ACTIONS_PER_DAY=1000           # daily server-wide cap for each action
# JOBS_SYNC_ENABLED=true               # production launcher: maintain the catalog
# OPENROUTER_PROVIDER=google-vertex     # only this provider; no fallback to other providers
# Disable shared capacity in the OpenRouter BYOK integration to require your own key.
# DATA_DIR=data                         # relative to backend/; absolute paths also work
# PARSE_MODEL=google/gemini-3.8-flash
# PARSE_REASONING=low                   # Gemini 3.8 Flash requires some reasoning
# DESIGN_MODEL=google/gemini-3.8-flash   # visual reconstruction of the original CV
# TAILOR_MODEL=google/gemini-3.8-flash   # selection of existing facts for each job
# DESIGN_MAX_ITERATIONS=3               # rendered drafts compared with original pages
# DESIGN_TIMEOUT_SECONDS=300
# RENDER_TIMEOUT_SECONDS=60
# ARTIFACT_WORKERS_ENABLED=true
# ARTIFACT_QUEUE_MAX_PENDING=100
# ARTIFACT_LEASE_SECONDS=90
# ARTIFACT_TIMEOUT_SECONDS=900
# ARTIFACT_POLL_SECONDS=0.5
# JEV_MODEL=jev-1.13.0
# MATCH_LIMIT=1000                      # roles scored per résumé
# MATCH_CONCURRENCY=32                  # Jev requests in flight
# QUEUE_MAX_PENDING=100                 # reject excess uploads with HTTP 429
# QUEUE_POLL_SECONDS=0.5
# QUEUE_LEASE_SECONDS=60                # recover work after a crashed API worker
# CATALOG_RETRY_SECONDS=30              # wait for the first usable jobs catalog
# PROCESSING_TIMEOUT_SECONDS=1800       # bound each processing attempt
# JOBS_REFRESH_HOURS=6                  # jobs-ingest skips runs more recent than this
