API_URL=http://127.0.0.1:8000
# Existing backend OpenRouter credentials also configure chat when MODEL is unset.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemini-3.8-flash
OPENROUTER_PROVIDER=google-vertex
# Optional explicit Anthropic alternative; never used as an error fallback.
# MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
DARWIN_MCP_URL=https://mcp.darwin.so/mcp
APP_ORIGIN=http://localhost:5173
PORT=4000
COPILOTKIT_TELEMETRY_DISABLED=true
